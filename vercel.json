{
  "rewrites": [
    {
      "source": "/barber/:path*",
      "destination": "https://barber.ninjai.com.br/barber/:path*"
    },
    {
      "source": "/_next/:path*",
      "destination": "https://barber.ninjai.com.br/_next/:path*"
    }
  ],
  "redirects": [
    {
      "source": "/lux",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Android|iPhone|iPod|Mobile|BlackBerry|IEMobile|Opera Mini).*"
        }
      ],
      "destination": "/lux/m/",
      "permanent": false
    },
    {
      "source": "/lux/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Android|iPhone|iPod|Mobile|BlackBerry|IEMobile|Opera Mini).*"
        }
      ],
      "destination": "/lux/m/",
      "permanent": false
    },
    {
      "source": "/lux2",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Android|iPhone|iPod|Mobile|BlackBerry|IEMobile|Opera Mini).*"
        }
      ],
      "destination": "/lux/m/",
      "permanent": false
    },
    {
      "source": "/lux2/",
      "has": [
        {
          "type": "header",
          "key": "user-agent",
          "value": ".*(Android|iPhone|iPod|Mobile|BlackBerry|IEMobile|Opera Mini).*"
        }
      ],
      "destination": "/lux/m/",
      "permanent": false
    }
  ]
}
